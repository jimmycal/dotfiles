[user]
	name  = James Calise
	email = jamescalise@icloud.com

[core]
	editor     = code --wait
	pager      = delta
	autocrlf   = input
	ignorecase = false

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	conflictstyle = zdiff3

[diff]
	algorithm      = histogram
	colorMoved     = default

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate    = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula

[alias]
	st  = status -sb
	co  = checkout
	br  = branch
	lg  = log --oneline --graph --decorate --all
	undo = reset --soft HEAD~1
	wip  = "!git add -A && git commit -m 'wip: checkpoint'"

[credential]
	helper = osxkeychain
